generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  fullName       String
  email          String     @unique
  password       String
  role           String     @default("user")
  status         String     @default("active")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  orders         Order[]
  assignedTables Table[]    @relation("TableAssignments")
  auditLogs      AuditLog[] @relation("AuditActor")
  stockIntakes   StockIntake[] @relation("StockIntakeCreator")
  stockMovements StockMovement[] @relation("StockMovementCreator")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  price              Float
  stock              Int                 @default(0)
  stockUnit          String              @default("cope")
  unitsPerPackage    Int?
  imageUrl           String?
  categoryId         Int?
  directStockIngredientId Int?
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  directStockIngredient Ingredient?       @relation("DirectStockProducts", fields: [directStockIngredientId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  supplierOrderItems SupplierOrderItem[]
  recipe             Recipe?
  isAvailable        Boolean             @default(true)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Table {
  id               Int                @id @default(autoincrement())
  number           Int                @unique
  capacity         Int
  location         String
  status           String             @default("available")
  assignedWaiterId Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orders           Order[]
  reservations     Reservation[]
  assignedWaiter   User?              @relation("TableAssignments", fields: [assignedWaiterId], references: [id])
  accessTokens     TableAccessToken[]

  @@index([assignedWaiterId])
}

model Employee {
  id             Int             @id @default(autoincrement())
  firstName      String
  lastName       String
  position       String
  phone          String
  email          String          @unique
  hireDate       DateTime
  salary         Float
  shift          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orders         Order[]
  supplierOrders SupplierOrder[]
  shifts         Shift[]
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         Int
  tableId        Int?
  employeeId     Int?
  subtotal       Float?
  discountType   String?
  discountValue  Float?
  discountAmount Float       @default(0)
  total          Float
  paymentMethod  String?
  status         String      @default("pending")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  table          Table?      @relation(fields: [tableId], references: [id])
  employee       Employee?   @relation(fields: [employeeId], references: [id])
  items          OrderItem[]

  @@index([userId])
  @@index([tableId])
  @@index([employeeId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Reservation {
  id             Int      @id @default(autoincrement())
  customerName   String
  phone          String
  tableId        Int
  date           DateTime @db.Date
  time           String
  numberOfPeople Int
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  table          Table    @relation(fields: [tableId], references: [id])

  @@index([tableId, date, time])
}

model Supplier {
  id             Int             @id @default(autoincrement())
  contactName    String
  companyName    String
  phone          String
  email          String?         @unique
  address        String?
  productType    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventories    Inventory[]
  supplierOrders SupplierOrder[]
  stockIntakes   StockIntake[]
}

model Ingredient {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  sku             String?           @unique
  baseUnit        String
  currentQuantity Decimal           @default(0) @db.Decimal(14, 3)
  minimumQuantity Decimal           @default(0) @db.Decimal(14, 3)
  averageCost     Decimal           @default(0) @db.Decimal(12, 4)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipeItems     RecipeItem[]
  directStockProducts Product[]     @relation("DirectStockProducts")
  stockIntakeItems StockIntakeItem[]
  stockMovements  StockMovement[]

  @@index([baseUnit])
  @@index([isActive])
}

model Recipe {
  id        Int          @id @default(autoincrement())
  productId Int         @unique
  version   Int         @default(1)
  isActive  Boolean     @default(true)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     RecipeItem[]
}

model RecipeItem {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(14, 3)
  unit         String
  createdAt    DateTime   @default(now())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([ingredientId])
}

model StockIntake {
  id            Int               @id @default(autoincrement())
  supplierId    Int
  invoiceNumber String?
  notes         String?
  status        String            @default("draft")
  totalCost     Decimal           @default(0) @db.Decimal(12, 2)
  confirmedAt   DateTime?
  createdById   Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  createdBy     User              @relation("StockIntakeCreator", fields: [createdById], references: [id])
  items         StockIntakeItem[]
  movements     StockMovement[]

  @@index([supplierId, createdAt])
  @@index([createdById])
  @@index([status, createdAt])
}

model StockIntakeItem {
  id               Int          @id @default(autoincrement())
  stockIntakeId    Int
  ingredientId      Int
  purchasedQuantity Decimal     @db.Decimal(14, 3)
  purchasedUnit     String
  baseQuantity      Decimal     @db.Decimal(14, 3)
  baseUnit          String
  unitCost          Decimal     @db.Decimal(12, 4)
  lineTotal         Decimal     @db.Decimal(12, 2)
  createdAt         DateTime    @default(now())
  stockIntake       StockIntake @relation(fields: [stockIntakeId], references: [id], onDelete: Cascade)
  ingredient        Ingredient  @relation(fields: [ingredientId], references: [id])

  @@index([stockIntakeId])
  @@index([ingredientId])
}

model StockMovement {
  id              Int        @id @default(autoincrement())
  ingredientId    Int
  stockIntakeId   Int?
  type            String
  sourceType      String
  sourceId        String?
  quantity        Decimal    @db.Decimal(14, 3)
  unit            String
  previousStock   Decimal    @db.Decimal(14, 3)
  newStock        Decimal    @db.Decimal(14, 3)
  unitCost        Decimal?   @db.Decimal(12, 4)
  totalCost       Decimal?   @db.Decimal(12, 2)
  reason          String?
  createdById     Int?
  createdAt       DateTime   @default(now())
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  stockIntake     StockIntake? @relation(fields: [stockIntakeId], references: [id])
  createdBy       User?      @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ingredientId, createdAt])
  @@index([stockIntakeId])
  @@index([type, createdAt])
  @@index([sourceType, sourceId])
}

model Inventory {
  id              Int      @id @default(autoincrement())
  itemName        String
  unit            String
  currentQuantity Float
  minimumQuantity Float
  unitPrice       Float
  supplierId      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  supplier        Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

model SupplierOrder {
  id            Int                 @id @default(autoincrement())
  supplierId    Int
  employeeId    Int?
  invoiceNumber String?
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  total         Float
  status        String              @default("pending")
  notes         String?
  receivedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  employee      Employee?           @relation(fields: [employeeId], references: [id])
  items         SupplierOrderItem[]

  @@index([supplierId])
  @@index([employeeId])
}

model SupplierOrderItem {
  id                        Int           @id @default(autoincrement())
  supplierOrderId           Int
  productId                 Int
  quantity                  Int
  unitPrice                 Float
  unit                      String        @default("cope")
  stockQuantity             Int           @default(0)
  stockUnit                 String        @default("cope")
  stockUnitsPerPurchaseUnit Int           @default(1)
  supplierOrder             SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  product                   Product       @relation(fields: [productId], references: [id])

  @@index([supplierOrderId])
  @@index([productId])
}

model Shift {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date
  startTime  String
  endTime    String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
}

model Expense {
  id            Int      @id @default(autoincrement())
  category      String
  description   String?
  amount        Float
  date          DateTime @default(now())
  paymentMethod String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actorName  String?
  actorRole  String?
  method     String
  route      String
  action     String
  entityType String?
  entityId   String?
  statusCode Int
  summary    String?
  ipAddress  String?
  userAgent  String?
  payload    Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model SystemAlert {
  id         Int       @id @default(autoincrement())
  type       String
  severity   String    @default("warning")
  title      String
  message    String
  status     String    @default("open")
  entityType String?
  entityId   String?
  meta       Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([type, entityType, entityId])
}

model TableAccessToken {
  id        Int       @id @default(autoincrement())
  tableId   Int
  token     String    @unique
  status    String    @default("active")
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, status])
}
