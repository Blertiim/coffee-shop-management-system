DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/coffee_shop_management"
JWT_SECRET="replace-with-a-long-random-production-secret"
NODE_ENV="production"
PORT=5000
HOST=0.0.0.0

# Set this to the exact frontend production origin.
# Examples:
# CORS_ORIGINS="https://pos.example.com"
# CORS_ORIGINS="https://pos.example.com,https://www.pos.example.com"
CORS_ORIGINS="https://your-frontend-domain.com"

# API docs are disabled by default in production.
# If you must expose them, keep them behind credentials.
API_DOCS_ENABLED="false"
API_DOCS_USERNAME=""
API_DOCS_PASSWORD=""

# Public browser URL for QR/guest links.
GUEST_ORDER_PUBLIC_BASE_URL="https://your-frontend-domain.com"

BACKUP_OUTPUT_DIR="./backups"
BACKUP_SYNC_DIR=""
REPORT_OUTPUT_DIR="./reports"
REPORT_SYNC_DIR=""
INVENTORY_ALERT_RETRY_MS=30000
